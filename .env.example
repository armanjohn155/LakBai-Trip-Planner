# Copy to .env and adjust as needed. docker compose reads this for variable
# substitution in docker-compose.yml.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Administrator account created by the AdminSeeder (php artisan db:seed).
# Both values are required; the seeder fails loudly when they are missing.
# Use a long, unique password and change it after the first login.
ADMIN_EMAIL=admin@lakbai.test
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

# GPS check-in verification thresholds (App\Services\CheckInVerifier).
LAKBAI_CHECKIN_MAX_ACCURACY_M=100
LAKBAI_CHECKIN_COOLDOWN_HOURS=12
LAKBAI_CHECKIN_DEFAULT_RADIUS_M=150
LAKBAI_CHECKIN_MAX_SPEED_KMH=900