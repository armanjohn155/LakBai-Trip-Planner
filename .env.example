# Docker Compose substitution values. Copy to .env and fill locally.
# Never commit real credentials. Render reads none of these values.
APP_NAME=LakBai
APP_ENV=local
APP_DEBUG=true
APP_KEY=
APP_URL=http://localhost:8080
APP_PORT=8080

# Neon PostgreSQL. DB_URL is the pooled connection string; DB_URL_DIRECT is
# the direct connection string used only when RUN_MIGRATIONS=true.
NEON_DB_URL=postgresql://<user>:<password>@<pooled-host>:5432/<database>?sslmode=require
NEON_DB_URL_DIRECT=postgresql://<user>:<password>@<direct-host>:5432/<database>?sslmode=require
RUN_MIGRATIONS=true

# Google OAuth 2.0 (compose passes these to the backend).
# Authorized JavaScript origin: http://localhost:8080
# Authorized redirect URI:      http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:8080

# Laravel Reverb (local Docker values only).
REVERB_APP_ID=lakbai-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http

# Admin bootstrap (used only by AdminSeeder when explicitly run).
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=
