# Base URL for the Laravel API. Vite proxies /api to the backend in dev (see vite.config.ts).
VITE_API_URL=/api

# Laravel Reverb (WebSocket) for real-time/group tracking.
# Must match backend REVERB_APP_KEY and server settings. Leave as-is for local dev;
# without a running Reverb server the app falls back to polling where supported.
VITE_REVERB_APP_KEY=lakbai-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http
