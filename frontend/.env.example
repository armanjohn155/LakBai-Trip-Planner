# Base URL for the Laravel API, including the /api prefix.
# Local Docker uses /api (nginx proxies it to the backend). Render uses the
# absolute HTTPS URL of the lakbai-api service.
VITE_API_URL=/api
# VITE_API_URL=https://<api-service-host>/api

VITE_APP_NAME=LakBai

# Laravel Reverb (WebSocket) for group live tracking. These must match the
# backend REVERB_APP_KEY and server. Leave VITE_REVERB_APP_KEY empty to disable
# WebSockets and use polling.
VITE_REVERB_APP_KEY=
# VITE_REVERB_HOST=<reverb-service-host>
# VITE_REVERB_PORT=443
# VITE_REVERB_SCHEME=https
