# Base URL for the Laravel API. Must be prefixed with VITE_ to be exposed to the client.
# Both Vite (dev) and nginx (Docker) proxy the relative /api path, so this works everywhere:
VITE_API_URL=/api

# If you need to call the API directly without a proxy, use an absolute URL:
# VITE_API_URL=http://127.0.0.1:8000/api

# Laravel Reverb (WebSocket) for group live tracking. These must match the
# backend REVERB_APP_KEY and server. Without them the app falls back to the
# 10-second polling endpoint.
VITE_REVERB_APP_KEY=lakbai-local-key
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=6001
VITE_REVERB_SCHEME=http
