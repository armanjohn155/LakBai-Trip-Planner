# Copy to .env and adjust as needed. docker compose reads this for variable
# substitution in docker-compose.yml.
APP_KEY=base64:7bQwzvR8f2JkLmNpQxYtUoP4sAdGhJkLzXcVbNmQaWE=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

# Google OAuth 2.0 (docker compose reads these for the app container).
# Create the OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized JavaScript origin: http://localhost:8080
# Authorized redirect URI:      http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK=http://localhost:8080/auth/google/callback
FRONTEND_URL=http://localhost:8080

# Laravel Reverb (WebSocket) for group live tracking. The frontend build reads
# these; inside Docker the Laravel services always publish to the `reverb`
# service on the compose network regardless of REVERB_HOST. Use long random
# values for anything reachable outside your machine.
REVERB_APP_ID=lakbai-local
REVERB_APP_KEY=lakbai-local-key
REVERB_APP_SECRET=lakbai-local-secret
# Browser-facing WebSocket host (must be reachable from the user's browser).
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http

# Administrator account created by the AdminSeeder (php artisan db:seed).
# Both values are required; the seeder fails loudly when they are missing.
# Use a long, unique password and change it after the first login.
ADMIN_EMAIL=admin@lakbai.test
ADMIN_NAME=Administrator
ADMIN_PASSWORD=eighjay1020
# GPS check-in verification thresholds (App\Services\CheckInVerifier).
LAKBAI_CHECKIN_MAX_ACCURACY_M=100
LAKBAI_CHECKIN_COOLDOWN_HOURS=12
LAKBAI_CHECKIN_DEFAULT_RADIUS_M=150
LAKBAI_CHECKIN_MAX_SPEED_KMH=900

NEON_DB_URL=postgresql://neondb_owner:npg_7CwpWY2inSao@ep-cold-glade-a1jnbchm-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require