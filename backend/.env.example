# Local development example. Render uses dashboard environment variables only.
APP_NAME=LakBai
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_FORCE_HTTPS=false
TRUSTED_PROXIES=
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# Neon PostgreSQL. DB_URL is pooled; DB_URL_DIRECT is used for migrations.
DB_CONNECTION=pgsql
DB_URL=postgresql://<user>:<password>@<pooled-host>:5432/<database>?sslmode=require
DB_URL_DIRECT=postgresql://<user>:<password>@<direct-host>:5432/<database>?sslmode=require
RUN_MIGRATIONS=false
DB_HOST=<host>
DB_PORT=5432
DB_DATABASE=<database>
DB_USERNAME=<user>
DB_PASSWORD=<password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
SESSION_PARTITIONED_COOKIE=false
SESSION_HTTP_ONLY=true

QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Public uploads stay local here; use s3 plus the AWS_* values on Render.
FILESYSTEM_DISK=local
PUBLIC_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=lakbai-local
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=6001
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6001
REVERB_ALLOWED_ORIGINS=*

CORS_ALLOWED_ORIGINS=
SANCTUM_STATEFUL_DOMAINS=
SANCTUM_TOKEN_PREFIX=
FRONTEND_URL=http://localhost:5173

# Mail: log locally; use smtp (or Resend SMTP) in production.
MAIL_MAILER=log
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
GOOGLE_FRONTEND_CALLBACK=http://localhost:5173/auth/google/callback

# Admin bootstrap (set these only when explicitly running AdminSeeder).
ADMIN_EMAIL=
ADMIN_NAME=Administrator
ADMIN_PASSWORD=

ROUTING_PROVIDER=osrm
LAKBAI_OSRM_URL=https://router.project-osrm.org
LAKBAI_OSRM_TIMEOUT=8
LAKBAI_ROUTE_ESTIMATES=true
LAKBAI_ROUTE_CACHE_TTL=1209600
LAKBAI_ROUTE_FALLBACK_SPEED_KMH=30
LAKBAI_CHECKIN_COOLDOWN_HOURS=12
LAKBAI_CHECKIN_DEFAULT_RADIUS_M=100
LAKBAI_CHECKIN_MAX_ACCURACY_M=100
LAKBAI_CHECKIN_MAX_SPEED_KMH=400
LAKBAI_EXPORT_THROTTLE=20,1
LAKBAI_EXPORT_TIMEZONE=Asia/Manila
LAKBAI_FRIEND_READ_THROTTLE=60,1
LAKBAI_FRIEND_REQUEST_THROTTLE=15,1
LAKBAI_FRIEND_CODE_REGEN_THROTTLE=5,1
LAKBAI_FRIEND_RESEND_COOLDOWN_DAYS=7
LAKBAI_INVITE_EXPIRY_DAYS=7
LAKBAI_INVITE_MAX_EXPIRY_DAYS=30
LAKBAI_INVITE_THROTTLE=10,1
LAKBAI_INVITE_ACCEPT_THROTTLE=10,1
LAKBAI_MAX_ITINERARY_INVITES=20
LAKBAI_MAX_ITINERARY_MEMBERS=20
LAKBAI_NOTIFICATION_BATCH_WINDOW_MINUTES=5
LAKBAI_NOTIFICATION_PRUNE_READ_DAYS=30
LAKBAI_NOTIFICATION_PRUNE_ALL_DAYS=90
LAKBAI_NOTIFICATION_STARTING_SOON_DAYS=1
