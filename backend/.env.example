APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Administrator account created by the AdminSeeder (php artisan db:seed).
ADMIN_EMAIL=admin@lakbai.test
ADMIN_NAME=Administrator
ADMIN_PASSWORD=eighjay1020

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# GPS check-in verification thresholds (App\Services\CheckInVerifier).
LAKBAI_CHECKIN_MAX_ACCURACY_M=100
LAKBAI_CHECKIN_COOLDOWN_HOURS=12
LAKBAI_CHECKIN_DEFAULT_RADIUS_M=150
LAKBAI_CHECKIN_MAX_SPEED_KMH=900

# Itinerary routing estimates (optional). Disabled by default. The OSRM demo
# server below is for LIGHT DEVELOPMENT USE ONLY — self-host for production.
LAKBAI_ROUTE_ESTIMATES=false
LAKBAI_OSRM_URL=https://router.project-osrm.org
LAKBAI_OSRM_TIMEOUT=4
LAKBAI_ROUTE_CACHE_TTL=86400
LAKBAI_ROUTE_FALLBACK_SPEED_KMH=30

# Itinerary exports (PDF / ICS / GPX): throttle (attempts,minutes) and timezone.
LAKBAI_EXPORT_THROTTLE=20,1
LAKBAI_EXPORT_TIMEZONE=Asia/Manila

# Itinerary sharing & collaboration
# FRONTEND_URL is used to build invite links returned by the API.
FRONTEND_URL=http://localhost:5173
LAKBAI_MAX_ITINERARY_MEMBERS=20
LAKBAI_MAX_ITINERARY_INVITES=20
LAKBAI_INVITE_THROTTLE=20,1
LAKBAI_INVITE_ACCEPT_THROTTLE=10,1
LAKBAI_INVITE_EXPIRY_DAYS=7
LAKBAI_INVITE_MAX_EXPIRY_DAYS=30

# Friends
LAKBAI_FRIEND_RESEND_COOLDOWN_DAYS=7
LAKBAI_FRIEND_REQUEST_THROTTLE=15,1
LAKBAI_FRIEND_CODE_REGEN_THROTTLE=5,1
# Notifications: batch shared trip edits, starting-soon window, retention.
LAKBAI_NOTIFICATION_BATCH_WINDOW_MINUTES=15
LAKBAI_NOTIFICATION_STARTING_SOON_DAYS=2
LAKBAI_NOTIFICATION_PRUNE_READ_DAYS=30
LAKBAI_NOTIFICATION_PRUNE_ALL_DAYS=90

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
